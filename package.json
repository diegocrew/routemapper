{
  "name": "routemapper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && npm run check:sea-routes && tsc -b && vite build",
    "generate:sea-routes": "uv run --with searoute==1.6.0 python tools/generate_sea_routes.py",
    "generate:inland-routes": "node tools/generateInlandWaterRoutes.mjs",
    "generate:rail-routes": "node tools/generateRailRoutes.mjs",
    "generate:truck-edges": "node tools/generateTruckEdges.mjs",
    "generate:edge-zones": "node tools/tagEdgeZones.mjs",
    "fetch:hazards": "node tools/fetchHazards.mjs",
    "retag:hazards": "node tools/fetchHazards.mjs --retag",
    "fetch:military-bases": "node tools/fetchMilitaryBases.mjs",
    "check:sea-routes": "node tools/checkSeaRoutes.cjs",
    "validate:data": "node tools/validateData.mjs",
    "audit:geography": "node tools/auditGeography.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "maplibre-gl": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
